<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 시뮬레이터 모드에서는 권한이 필요 없다. 실제 Pleos SDK 어댑터로 바꿀 때
         Pleos Playground 문서의 SDK별 권한 선언을 여기에 추가한다 (README 참고). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gilmok">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 시연 영상 제작용: 해설 문장을 앱과 같은 TTS 음성으로 파일에 합성한다 (tools/build_audio_from_log.py). -->
        <receiver android:name=".sdk.sim.TtsFileReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.zainoha.gilmok.TTS_TO_FILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
